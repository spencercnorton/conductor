# Conductor — example environment.
# Real values are stored in your secret manager; local dev can copy this file to .env (gitignored).

# HTTP listen address. Default :8409 (Conductor convention; not a real
# HDHomeRun port — SiliconDust uses :80 which collides with too many things).
CONDUCTOR_LISTEN=:8409

# URL Plex uses to reach this device. MUST be set in production so the
# device.xml / lineup.json / icon URLs resolve from every Plex client.
CONDUCTOR_BASE_URL=http://localhost:8409

# Tuner count advertised in /discover.json — falls back to env when no
# credentials are configured. Once at least one credential exists,
# Conductor derives this from sum(max_streams) at boot.
CONDUCTOR_TUNER_COUNT=8

# Persistent state dir.
CONDUCTOR_DATA_DIR=/var/lib/conductor

# --- Phase 1+ (Postgres-backed runtime) ---

# Postgres DSN. Empty disables DB mode (discovery-only fallback).
CONDUCTOR_POSTGRES_DSN=postgres://conductor:conductor@localhost:5432/conductor?sslmode=disable

# Postgres password used by docker-compose.example.yml.
POSTGRES_PASSWORD=conductor

# AES-GCM key for encrypting provider credential passwords at rest.
# 32 bytes hex-encoded. Generate: openssl rand -hex 32
# REQUIRED to create credentials via the admin API.
CONDUCTOR_CRED_KEY=

# --- Auth integration (admin surface only — Plex hits HDHomeRun + XMLTV unauthed) ---

# Static API key for CLI / service callers. `Authorization: Bearer <key>`.
# Generate: openssl rand -hex 32
CONDUCTOR_ADMIN_API_KEY=

# Portal base URL used to validate the ge_sso cookie via GET /api/auth/me.
# The app does not decode the token itself (no shared HMAC secret) — the
# portal is the single token validator. No default: unset means SSO cookies
# are not accepted and only the admin Bearer key authenticates.
CONDUCTOR_AUTH_PORTAL_URL=

# Cookie name. Default is "ge_sso" matching auth-portal convention.
# CONDUCTOR_SSO_COOKIE_NAME=ge_sso

# Comma-separated list of principal_id values permitted to call /admin/*.
# Empty = any valid JWT is accepted (single-tenant home-lab default).
# Production: set the owner's principal_id to lock the admin surface.
# CONDUCTOR_AUTH_PRINCIPALS=123456789

# Force-disable auth (bypasses both ADMIN_API_KEY and JWT). Useful for
# fresh-install bring-up before secrets are wired. Defaults to true when
# either secret is configured.
# CONDUCTOR_AUTH_ENABLED=true

# --- Operational alerting (ops bot) ---
# CONDUCTOR_OPSBOT_WEBHOOK=https://ops.example.com/webhooks/conductor
# CONDUCTOR_OPSBOT_SECRET=

# --- EPG ingest cadence ---
# CONDUCTOR_EPG_INTERVAL=6h

# --- DVR-as-Indexer (Phase 3a) ---
# Conductor exposes a Torznab indexer that searches the EPG and
# auto-schedules a DVR recording when *arr "grabs" a result.
#
# Operator setup is in docs/enhancements.md section 10.

# Torznab apikey shared with Prowlarr. Empty disables the entire DVR
# indexer surface (caps, search, /dvr/schedule.torrent, scheduler goroutine).
# Generate: openssl rand -hex 24
CONDUCTOR_DVR_INDEXER_KEY=

# Where finished DVR recordings are written. Mount this into Conductor +
# point Sonarr/Radarr's library scan at it (Sonarr: Settings → Media
# Management → Root Folders, or use a Remote Path Mapping).
# Default: <CONDUCTOR_DATA_DIR>/dvr.
# CONDUCTOR_DVR_OUTPUT_DIR=/var/lib/conductor/dvr

# Friendly name shown to Prowlarr in the caps response.
# CONDUCTOR_DVR_INDEXER_NAME=Conductor DVR

# Capacity admission. Schedule requests immediately expose an advisory padded-
# window conflict without holding a slot; the scheduler reserves the real
# provider lease before it claims the recording or opens a file. Earlier padded
# starts are non-preemptible; lower recording priority, creation time, and UUID
# order only requests with the same start boundary.
# One provider slot is retained for live TV by default. Set 0 to let DVR use
# every slot; one-slot providers are automatically clamped so they can record.
# CONDUCTOR_DVR_LIVE_RESERVE=1
# CONDUCTOR_DVR_DEFAULT_PRIORITY=100

# A temporary capacity conflict stays queued and retries immediately on slot
# release, with this cadence as a fallback. The retry budget starts at padded
# start and is always capped at the program's scheduled end.
# CONDUCTOR_DVR_CAPACITY_RETRY_INTERVAL=5s
# CONDUCTOR_DVR_CAPACITY_RETRY_WINDOW=5m

# Recording padding. Adjacent programs overlap for the sum of these values.
# CONDUCTOR_DVR_START_SLACK=30s
# CONDUCTOR_DVR_MAX_OVERRUN=90s

# --- Live transcoding (Phase 4) ---
# Path to ffmpeg. Empty = use "ffmpeg" on PATH. Set when running in a
# container that has ffmpeg at a non-standard location.
# CONDUCTOR_FFMPEG_BINARY=/usr/bin/ffmpeg

# Six built-in transcode profiles ship in migration 0006:
#   passthrough, stabilize-cpu, nvenc-1080p, nvenc-720p,
#   hdr-to-sdr-nvenc, audio-fix
# Assign per channel:  PUT /admin/channels/{id}/transcode
# Assign per source:   PUT /admin/channels/{id}/sources/{src_id}/transcode
# Source override > channel default > nil (passthrough)
#
# For the GPU-accelerated profiles (nvenc-*) the Conductor container needs
# nvidia runtime + ffmpeg-with-nvenc. See the deployment guide.

# --- Post-record pipeline (Phase 4b) ---
# When set, Conductor calls the commskip-auto service after every
# completed DVR recording. commskip-auto runs Comskip + Whisper + LLM as
# a hybrid pipeline — it produces
# .edl + .srt sidecars next to the .ts file. Sonarr's library scan
# imports all three.
# Empty = post-processing disabled.
CONDUCTOR_COMMSKIP_URL=
CONDUCTOR_COMMSKIP_API_KEY=

# --- Optional enrichment integrations (Phase 3+) ---
# CONDUCTOR_IMAGE_GEN_BASE_URL=http://image-gen.internal:8920
# CONDUCTOR_IMAGE_GEN_API_KEY=
# CONDUCTOR_INTEL_BASE_URL=http://grounded-match.internal:8930
# CONDUCTOR_INTEL_API_KEY=

# --- TMDb enrichment (Phase 3) ---
# When set, the enrichment worker drains epg_program rows whose
# enrichment_status='pending', looks them up via TMDb, and writes the
# matched poster/backdrop/overview/IMDb id into epg_program_enrichment.
# The XMLTV output prefers enriched values over source EPG values.
#
# TMDb v3 API key (free tier is fine):
#   https://www.themoviedb.org/settings/api
CONDUCTOR_TMDB_API_KEY=
# CONDUCTOR_TMDB_BASE_URL=https://api.themoviedb.org/3
# CONDUCTOR_ENRICH_INTERVAL=5m

# --- TVDB fallback (Phase 3b) ---
# When set + TMDb misses, the enricher falls back to TheTVDB v4.
# Free tier works; paid subscriber PIN is optional.
# Get a project key: https://thetvdb.com/api-information
CONDUCTOR_TVDB_API_KEY=
# CONDUCTOR_TVDB_PIN=
# CONDUCTOR_TVDB_BASE_URL=https://api4.thetvdb.com/v4

# --- Schedules Direct (Phase 3b) ---
# Paid EPG service ($25/yr) — gold-standard US/CA broadcast TV.
# When set, a separate ingester pulls schedules + program details from
# SD and writes them as epg_program rows on the same cadence as the
# XMLTV worker (CONDUCTOR_EPG_INTERVAL).
#
# Operator must:
#  1. Sign up at https://schedulesdirect.org and add a lineup via web UI
#  2. POST /admin/sd/lineups with {sd_lineup_id:"USA-OTA-80127",...}
#  3. For each Conductor channel matched to an SD station, set
#     channel.epg_channel_id = "<sd_station_id>"
CONDUCTOR_SD_USERNAME=
CONDUCTOR_SD_PASSWORD=
# CONDUCTOR_SD_BASE_URL=https://json.schedulesdirect.org/20141201

# --- Future enrichment sources (not yet wired) ---
# CONDUCTOR_THESPORTSDB_API_KEY=
